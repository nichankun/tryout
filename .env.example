DATABASE_URL=postgresql://user:password@host:5432/database
# Use false for Dokploy's private internal database URL; set true only if the endpoint supports TLS.
DATABASE_SSL=false
# Better Auth. Generate a fresh random secret with at least 32 bytes for production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://asnpedia.kelonika.my.id
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Cloudflare-proxied app: only trust this after restricting direct origin access.
AUTH_CLIENT_IP_HEADER=cf-connecting-ip
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
RESEND_API_KEY=
# Pengirim email otomatis; balasan diarahkan ke SUPPORT_EMAIL.
RESEND_FROM_EMAIL=noOKreply@mail.kelonika.my.id
NEXT_PUBLIC_APP_URL=https://asnpedia.kelonika.my.id
BUSINESS_LEGAL_NAME=
BUSINESS_CONTACT_ADDRESS=
# Alamat bantuan yang ditampilkan kepada pengguna dan menjadi Reply-To.
# Siapkan mailbox/forwarding untuk alias ini sebelum mempublikasikannya.
SUPPORT_EMAIL=bantuan@mail.kelonika.my.id
SUPPORT_PHONE=
POLICY_EFFECTIVE_DATE=YYYY-MM-DD
QUESTION_IMAGE_S3_ENDPOINT=
QUESTION_IMAGE_S3_REGION=us-east-1
QUESTION_IMAGE_S3_BUCKET=
QUESTION_IMAGE_S3_ACCESS_KEY_ID=
QUESTION_IMAGE_S3_SECRET_ACCESS_KEY=
